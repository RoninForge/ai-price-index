{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RoninForge/ai-price-index/schema/model-series.schema.json",
  "title": "AI Price Index per-model time-series (published artifact)",
  "description": "The resolved, currently-believed valid-time series for one model. This is the static, CDN-cacheable form the web tool and downstream consumers read; the client never runs bitemporal logic. Generated from the system of record; do not hand-edit (the next export overwrites it).",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "provider", "variations"],
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "variations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "price_usd", "unit", "last_validated", "confidence", "src"],
          "properties": {
            "from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "to": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "price_usd": { "type": "number", "minimum": 0 },
            "unit": { "type": "string" },
            "last_validated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "confidence": { "type": "string", "enum": ["verified", "archived", "inferred", "estimated"] },
            "src": { "type": "string", "pattern": "^https?://" },
            "snapshot": { "type": "string", "pattern": "^\\d{8,14}$" }
          }
        }
      }
    }
  }
}
