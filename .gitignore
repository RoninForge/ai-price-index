node_modules/
.DS_Store
*.log
.env
.env.*

# the SQLite system-of-record is runtime state (lives on the VPS, regenerable from data/records);
# the repo holds the schema, tooling, curated records, and the exported artifacts, not the binary DB
db/*.db
db/*.db-wal
db/*.db-shm

# derived export artifacts (regenerable via tools/hf-export.mjs)
dist/

# the npm package's inline data bundle (regenerable via tools/build-npm.mjs, built on prepare/prepack)
lib/data.json

# the sentinel's human-readable run report. Regenerable via `node tools/sentinel/run.mjs --apply`,
# and used only as the rolling PR's BODY - price-sentinel.yml stages `data/records` exclusively and
# never commits this file. Ignored so a local --apply cannot sneak it into a commit.
sentinel-report.md
